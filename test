-- ─── INTERFACE PLUGGABLE (7 fonctions) ───────────────────────────────────────

-- Override ces fonctions pour adapter à n'importe quel jeu.

-- Retourne le Model/character de l'entité (joueur ou NPC)
function Lib.getCharacter(entity)
    if typeof(entity) == "Instance" and entity:IsA("Player") then
        return entity.Character
    end
    -- NPC : l'entité EST le model
    if typeof(entity) == "Instance" and entity:IsA("Model") then
        return entity
    end
    return nil
end

-- Retourne health, maxHealth (nil = pas de health bar)
function Lib.getHealth(entity)
    local char = Lib.getCharacter(entity)
    if not char then return nil, nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health, hum.MaxHealth end
    return nil, nil
end

-- Retourne le nom de l'arme équipée (nil = caché)
function Lib.getWeapon(entity)
    local char = Lib.getCharacter(entity)
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then return child.Name end
    end
    return nil
end

-- true = on n'affiche pas d'ESP sur cette entité
function Lib.isFriendly(entity)
    if typeof(entity) == "Instance" and entity:IsA("Player") then
        return entity.Team ~= nil and entity.Team == LocalPlayer.Team
    end
    return false
end

-- Retourne la couleur de team (nil = utilise config)
function Lib.getTeamColor(entity)
    if typeof(entity) == "Instance" and entity:IsA("Player") then
        local t = entity.Team
        return t and t.TeamColor and t.TeamColor.Color or nil
    end
    return nil
end

-- Retourne la clé dans teamSettings pour cette entité
function Lib.getTeamKey(entity)
    if Lib.isFriendly(entity) then return "friendly" end
    return "enemy"
end

-- Pour les instances non-joueurs (NPC, Part, Model)
function Lib.getNPCTeamKey(instance)
    return "default"
end

-- ─── COLOR RESOLVER ──────────────────────────────────────────────────────────

local function resolveColor(lib, entity, colorPair, isOutline)
    local s = lib.sharedSettings
    if s.rainbow then
        return lib._rainbow.color
    end
    if s.useTeamColor and not isOutline then
        local tc = lib.getTeamColor(entity)
        if tc then return tc end
    end
    if typeof(colorPair) == "table" then
        return colorPair[1], colorPair[2]
    end
    return colorPair
end

local function getConfig(lib, entity)
    local key = lib.getTeamKey(entity)
    return lib.teamSettings[key]
        or lib.teamSettings["default"]
        or defaultTeamConfig()
end

local function getNPCConfig(lib, instance)
    local key = lib.getNPCTeamKey(instance)
    return lib.teamSettings[key]
        or lib.teamSettings["default"]
        or defaultTeamConfig()
end

-- ─── OFFSETS ─────────────────────────────────────────────────────────────────

local HBAR_OFFSET    = Vector2.new(8,  0)
local HBAR_OL_OFFSET = Vector2.new(0,  1)
local NAME_OFFSET    = Vector2.new(0,  2)
local DIST_OFFSET    = Vector2.new(0,  2)

-- ─── ESP OBJECT ──────────────────────────────────────────────────────────────

local EspObject = {}
EspObject.__index = EspObject

function EspObject.new(entity, lib)
    local self = setmetatable({}, EspObject)
    self.entity   = entity
    self.lib      = lib
    self.bin      = {}
    self._parts   = {}
    self._skelSeq = nil
    self._skelCache = {}
    self:_build()
    self._conn = RunService.Heartbeat:Connect(function()
        self:Update()
        self:Render()
    end)
    return self
end

function EspObject:_draw(class, props)
    local d = newDrawing(class, props)
    self.bin[#self.bin+1] = d
    return d
end

function EspObject:_build()
    local D = {}

    -- box 2D
    D.boxOuter = self:_draw("Square", { Thickness=3, Visible=false })
    D.box      = self:_draw("Square", { Thickness=1, Visible=false })
    D.boxInner = self:_draw("Square", { Thickness=1, Visible=false })
    D.boxFill  = self:_draw("Square", { Filled=true, Visible=false })

    -- box 3D (4 faces × 3 lignes)
    D.box3d = {}
    for i=1,4 do
        D.box3d[i] = {
            self:_draw("Line", { Thickness=1, Visible=false }),
            self:_draw("Line", { Thickness=1, Visible=false }),
            self:_draw("Line", { Thickness=1, Visible=false }),
        }
    end

    -- health bar
    D.hbarOL = self:_draw("Line", { Thickness=3, Visible=false })
    D.hbar   = self:_draw("Line", { Thickness=1, Visible=false })
    D.htext  = self:_draw("Text", { Center=true, Visible=false })

    -- labels
    D.name     = self:_draw("Text", { Center=true, Visible=false })
    D.distance = self:_draw("Text", { Center=true, Visible=false })
    D.weapon   = self:_draw("Text", { Center=true, Visible=false })

    -- tracer
    D.tracerOL = self:_draw("Line", { Thickness=3, Visible=false })
    D.tracer   = self:_draw("Line", { Thickness=1, Visible=false })

    -- arrow
    D.arrowOL = self:_draw("Triangle", { Thickness=3, Visible=false })
    D.arrow   = self:_draw("Triangle", { Filled=true, Visible=false })

    -- skeleton (max 32 segments)
    D.skelLines = {}
    for i=1,32 do
        D.skelLines[i] = self:_draw("Line", { Thickness=1, Visible=false })
    end

    self.D = D

    -- nom display
    local entity = self.entity
    if typeof(entity) == "Instance" and entity:IsA("Player") then
        D.name.Text = entity.DisplayName
    elseif typeof(entity) == "Instance" then
        D.name.Text = entity.Name
    end
end

function EspObject:Destruct()
    if self._conn then self._conn:Disconnect() end
    for _, d in ipairs(self.bin) do d:Remove() end
    clear(self)
end

function EspObject:Update()
    local lib    = self.lib
    local entity = self.entity
    local cfg    = getConfig(lib, entity)

    -- whitelist check
    if #lib.whitelist > 0 then
        local uid = typeof(entity)=="Instance" and entity:IsA("Player") and entity.UserId
        if uid then
            local found = false
            for _, id in ipairs(lib.whitelist) do if id==uid then found=true break end end
            if not found then self._enabled=false self._onScreen=false return end
        end
    end

    self._cfg     = cfg
    self._enabled = cfg.enabled

    local char = lib.getCharacter(entity)
    self._char = char

    local head = char and char:FindFirstChild("Head")
    if not head then
        self._onScreen = false
        self._corners  = nil
        self._parts    = {}
        return
    end

    local _, onScreen, depth = worldToScreen(head.Position)

    if depth > cfg.maxDistance then
        self._onScreen = false
        return
    end

    self._onScreen = onScreen
    self._depth    = depth
    self._screenPos = worldToScreen(head.Position)

    if onScreen then
        -- refresh parts cache
        local children = char:GetChildren()
        if #children ~= self._childCount then
            self._childCount = #children
            self._parts = getBBoxParts(char)
        end

        if #self._parts > 0 then
            local cf, sz = computeBBox(self._parts)
            self._corners = calcCorners(cf, sz)
        end

        -- health
        self._health, self._maxHealth = lib.getHealth(entity)

        -- weapon
        self._weapon = lib.getWeapon(entity)

        -- skeleton sequence cache
        if cfg.skeleton and not self._skelSeq then
            self._skelSeq = getSkeletonSequence(char)
        end

    elseif cfg.offScreenArrow then
        local cf   = Camera.CFrame
        local flat = CFrame.fromMatrix(cf.Position, cf.RightVector, Vector3.yAxis)
        local obj  = flat:PointToObjectSpace(head.Position)
        self._direction = Vector2.new(obj.X, obj.Z).Unit
    end
end

function EspObject:Render()
    local lib     = self.lib
    local D       = self.D
    local cfg     = self._cfg
    local enabled = self._enabled and self._char ~= nil
    local onScreen= self._onScreen or false
    local corners = self._corners
    local entity  = self.entity
    local vp      = Camera.ViewportSize

    local function hide(d) d.Visible = false end
    local function col(pair, isOL) return resolveColor(lib, entity, pair, isOL) end

    -- callbacks
    if cfg and cfg.BeforeUpdate then pcall(cfg.BeforeUpdate, self) end

    if not cfg or not enabled then
        for _, d in ipairs(self.bin) do d.Visible = false end
        return
    end

    -- ── BOX 2D ──
    local boxVis = onScreen and cfg.box and corners ~= nil
    D.box.Visible      = boxVis
    D.boxOuter.Visible = boxVis and cfg.boxOutline
    D.boxInner.Visible = boxVis and cfg.boxOutline
    D.boxFill.Visible  = onScreen and cfg.boxFill and corners ~= nil

    if boxVis then
        local tl = corners.topLeft
        local br = corners.bottomRight
        local sz = br - tl
        local c, t = col(cfg.boxColor)
        local oc, ot = col(cfg.boxOutlineColor, true)

        D.box.Position=tl D.box.Size=sz D.box.Color=c D.box.Transparency=t
        D.boxOuter.Position=tl-Vector2.new(1,1) D.boxOuter.Size=sz+Vector2.new(2,2)
        D.boxOuter.Color=oc D.boxOuter.Transparency=ot D.boxOuter.Thickness=1
        D.boxInner.Position=tl+Vector2.new(1,1) D.boxInner.Size=sz-Vector2.new(2,2)
        D.boxInner.Color=oc D.boxInner.Transparency=ot D.boxInner.Thickness=1
    end

    if D.boxFill.Visible and corners then
        local c, t = col(cfg.boxFillColor)
        D.boxFill.Position=corners.topLeft
        D.boxFill.Size=corners.bottomRight-corners.topLeft
        D.boxFill.Color=c D.boxFill.Transparency=t
    end

    -- ── BOX 3D ──
    local b3vis = onScreen and cfg.box3d and corners ~= nil
    for i=1,4 do
        for j=1,3 do D.box3d[i][j].Visible=b3vis end
    end
    if b3vis then
        local c, t = col(cfg.box3dColor)
        for i=1,4 do
            local ni = (i%4)+1
            local f  = D.box3d[i]
            f[1].From=corners.corners[i]    f[1].To=corners.corners[ni]
            f[2].From=corners.corners[ni]   f[2].To=corners.corners[ni+4]
            f[3].From=corners.corners[ni+4] f[3].To=corners.corners[i+4]
            for j=1,3 do f[j].Color=c f[j].Transparency=t end
        end
    end

    -- ── HEALTH BAR ──
    local hvis = onScreen and cfg.healthBar and corners and self._health and self._maxHealth
    D.hbar.Visible   = hvis ~= nil and hvis ~= false
    D.hbarOL.Visible = D.hbar.Visible and cfg.healthBarOutline
    D.htext.Visible  = onScreen and cfg.healthText and hvis ~= nil and hvis ~= false

    if D.hbar.Visible then
        local hp, mhp = self._health, self._maxHealth
        local ratio   = clamp(hp/mhp, 0, 1)
        local tl      = corners.topLeft
        local bl      = corners.bottomLeft
        local barFrom = tl - HBAR_OFFSET
        local barTo   = bl - HBAR_OFFSET

        D.hbar.From  = Vector2.new(barFrom.X, barFrom.Y + (barTo.Y-barFrom.Y)*(1-ratio))
        D.hbar.To    = barTo
        D.hbar.Color = lerpColor(cfg.dyingColor, cfg.healthyColor, ratio)

        local oc, ot = col(cfg.healthBarOutlineColor, true)
        D.hbarOL.From  = barFrom - HBAR_OL_OFFSET
        D.hbarOL.To    = barTo   + HBAR_OL_OFFSET
        D.hbarOL.Color = oc D.hbarOL.Transparency = ot

        if D.htext.Visible then
            D.htext.Text = round(hp).."hp"
            D.htext.Size = lib.sharedSettings.textSize
            D.htext.Font = lib.sharedSettings.textFont
            local hc, ht = col(cfg.healthTextColor)
            D.htext.Color = hc D.htext.Transparency = ht
            D.htext.Outline = cfg.healthTextOutline
            D.htext.OutlineColor = cfg.healthTextOutlineColor
            local curPos = Vector2.new(barFrom.X, barFrom.Y + (barTo.Y-barFrom.Y)*(1-ratio))
            D.htext.Position = curPos - Vector2.new(
                D.htext.TextBounds.X*0.5 + HBAR_OFFSET.X + 6,
                D.htext.TextBounds.Y*0.5
            )
        end
    end

    -- ── NAME ──
    D.name.Visible = onScreen and cfg.name and corners ~= nil
    if D.name.Visible then
        local nc, nt = col(cfg.nameColor)
        D.name.Size = lib.sharedSettings.textSize
        D.name.Font = lib.sharedSettings.textFont
        D.name.Color = nc D.name.Transparency = nt
        D.name.Outline = cfg.nameOutline
        D.name.OutlineColor = cfg.nameOutlineColor
        D.name.Center = false
        local topCenter = (corners.topLeft + corners.topRight)*0.5
        D.name.Position = Vector2.new(
            topCenter.X - D.name.TextBounds.X*0.5,
            corners.topLeft.Y - D.name.TextBounds.Y - NAME_OFFSET.Y
        )
    end

    -- ── DISTANCE ──
    D.distance.Visible = onScreen and cfg.distance and corners ~= nil and self._depth ~= nil
    if D.distance.Visible then
        local dc, dt = col(cfg.distanceColor)
        D.distance.Text = round(self._depth).." studs"
        D.distance.Size = lib.sharedSettings.textSize
        D.distance.Font = lib.sharedSettings.textFont
        D.distance.Color = dc D.distance.Transparency = dt
        D.distance.Outline = cfg.distanceOutline
        D.distance.OutlineColor = cfg.distanceOutlineColor
        D.distance.Position = (corners.bottomLeft+corners.bottomRight)*0.5 + DIST_OFFSET
    end

    -- ── WEAPON ──
    D.weapon.Visible = onScreen and cfg.weapon and corners ~= nil and self._weapon ~= nil
    if D.weapon.Visible then
        local wc, wt = col(cfg.weaponColor)
        D.weapon.Text = self._weapon
        D.weapon.Size = lib.sharedSettings.textSize
        D.weapon.Font = lib.sharedSettings.textFont
        D.weapon.Color = wc D.weapon.Transparency = wt
        D.weapon.Outline = cfg.weaponOutline
        D.weapon.OutlineColor = cfg.weaponOutlineColor
        local base = (corners.bottomLeft+corners.bottomRight)*0.5
        D.weapon.Position = base + (D.distance.Visible
            and DIST_OFFSET + Vector2.new(0, D.distance.TextBounds.Y)
            or  Vector2.zero)
    end

    -- ── TRACER ──
    D.tracer.Visible   = onScreen and cfg.tracer and corners ~= nil
    D.tracerOL.Visible = D.tracer.Visible and cfg.tracerOutline
    if D.tracer.Visible then
        local tc, tt   = col(cfg.tracerColor)
        local oc, ot   = col(cfg.tracerOutlineColor, true)
        local origin
        local o = cfg.tracerOrigin
        if o == "Middle" then
            origin = vp * 0.5
        elseif o == "Top" then
            origin = vp * Vector2.new(0.5, 0)
        elseif o == "Mouse" then
            local m = UIS:GetMouseLocation()
            origin = Vector2.new(m.X, m.Y)
        else
            origin = vp * Vector2.new(0.5, 1)
        end
        local target = (corners.bottomLeft+corners.bottomRight)*0.5
        D.tracer.From=origin D.tracer.To=target D.tracer.Color=tc D.tracer.Transparency=tt
        D.tracerOL.From=origin D.tracerOL.To=target D.tracerOL.Color=oc D.tracerOL.Transparency=ot
    end

    -- ── ARROW ──
    D.arrow.Visible   = not onScreen and enabled and cfg.offScreenArrow
    D.arrowOL.Visible = D.arrow.Visible and cfg.offScreenArrowOutline
    if D.arrow.Visible and self._direction then
        local dir = self._direction
        local r   = cfg.offScreenArrowRadius
        local sz2 = cfg.offScreenArrowSize
        local ctr = vp * 0.5
        local raw = ctr + dir*r
        local pos = Vector2.new(
            clamp(raw.X, 25, vp.X-25),
            clamp(raw.Y, 25, vp.Y-25)
        )
        local ac, at = col(cfg.offScreenArrowColor)
        local oc, ot = col(cfg.offScreenArrowOutlineColor, true)
        D.arrow.PointA=pos
        D.arrow.PointB=pos - rotateVec(dir, 0.45)*sz2
        D.arrow.PointC=pos - rotateVec(dir,-0.45)*sz2
        D.arrow.Color=ac D.arrow.Transparency=at
        D.arrowOL.PointA=D.arrow.PointA D.arrowOL.PointB=D.arrow.PointB D.arrowOL.PointC=D.arrow.PointC
        D.arrowOL.Color=oc D.arrowOL.Transparency=ot
    end

    -- ── SKELETON ──
    local skelVis = onScreen and cfg.skeleton and self._skelSeq and self._char
    if skelVis then
        local seq   = self._skelSeq
        local cache = self._skelCache
        local sc, st = col(cfg.skeletonColor)
        local lineIdx = 0
        local prevPos = nil

        for _, name in ipairs(seq) do
            local part = cache[name]
            if not part then
                part = self._char:FindFirstChild(name)
                cache[name] = part
            end
            if part and part:IsA("BasePart") then
                local spos, vis = worldToScreen(part.Position)
                if vis then
                    if prevPos then
                        lineIdx = lineIdx + 1
                        if lineIdx <= #D.skelLines then
                            local l = D.skelLines[lineIdx]
                            l.Visible    = true
                            l.From       = prevPos
                            l.To         = spos
                            l.Color      = sc
                            l.Transparency = st
                            l.Thickness  = cfg.skeletonThickness
                        end
                    end
                    prevPos = spos
                else
                    prevPos = nil
                end
            else
                prevPos = nil
            end
        end

        -- hide unused lines
        for i = lineIdx+1, #D.skelLines do
            D.skelLines[i].Visible = false
        end
    else
        for _, l in ipairs(D.skelLines) do l.Visible = false end
    end

    -- callbacks
    if cfg.AfterUpdate then pcall(cfg.AfterUpdate, self) end
end

-- ─── CHAM OBJECT ─────────────────────────────────────────────────────────────

local ChamObject = {}
ChamObject.__index = ChamObject

function ChamObject.new(entity, lib)
    local self = setmetatable({}, ChamObject)
    self.entity    = entity
    self.lib       = lib
    self.highlight = Instance.new("Highlight", HighlightContainer)
    self._conn = RunService.Heartbeat:Connect(function() self:Update() end)
    return self
end

function ChamObject:Destruct()
    self._conn:Disconnect()
    self.highlight:Destroy()
    clear(self)
end

function ChamObject:Update()
    local lib  = self.lib
    local hl   = self.highlight
    local cfg  = getConfig(lib, self.entity)
    local char = lib.getCharacter(self.entity)

    hl.Enabled = cfg.enabled and cfg.chams and char ~= nil
    if not hl.Enabled then return end

    local fc, ft = resolveColor(lib, self.entity, cfg.chamsFillColor)
    local oc, ot = resolveColor(lib, self.entity, cfg.chamsOutlineColor, true)

    hl.Adornee            = char
    hl.FillColor          = fc
    hl.FillTransparency   = ft or 0.5
    hl.OutlineColor       = oc
    hl.OutlineTransparency= ot or 0
    hl.DepthMode          = cfg.chamsVisibleOnly
        and Enum.HighlightDepthMode.Occluded
        or  Enum.HighlightDepthMode.AlwaysOnTop
end

-- ─── INSTANCE OBJECT (NPC / Part / Model) ────────────────────────────────────

local InstanceObject = {}
InstanceObject.__index = InstanceObject

function InstanceObject.new(instance, lib, options)
    local self     = setmetatable({}, InstanceObject)
    self.instance  = instance
    self.lib       = lib
    self.options   = options or {}
    self.bin       = {}
    self._conn = RunService.Heartbeat:Connect(function() self:Render() end)

    -- crée un EspObject complet si c'est un Model avec des parts
    if instance:IsA("Model") then
        self._esp = EspObject.new(instance, lib)
        -- surcharge getTeamKey pour les NPC
        self._esp._getNPCKey = true
    else
        -- juste un label texte pour les Part loose
        self._label = newDrawing("Text", { Center=true, Visible=false })
        self.bin[1] = self._label
    end

    return self
end

function InstanceObject:Destruct()
    self._conn:Disconnect()
    if self._esp then self._esp:Destruct() end
    for _, d in ipairs(self.bin) do d:Remove() end
    clear(self)
end

function InstanceObject:Render()
    local inst = self.instance
    if not inst or not inst.Parent then
        return self:Destruct()
    end

    -- Model NPC : délégué à EspObject
    if self._esp then return end

    -- Part loose : label texte
    local opts  = self.options
    local label = self._label
    if not opts.enabled then label.Visible=false return end

    local pivot = inst:IsA("BasePart") and inst.Position or inst:GetPivot().Position
    local pos, vis, depth = worldToScreen(pivot)

    local maxDist = opts.maxDistance or 5000
    label.Visible = vis and depth <= maxDist

    if label.Visible then
        local text = opts.getText and opts.getText(inst)
            or (opts.text or inst.Name)
                :gsub("{name}", inst.Name)
                :gsub("{distance}", tostring(round(depth)))
        label.Text         = text
        label.Position     = pos
        label.Size         = opts.textSize or self.lib.sharedSettings.textSize
        label.Font         = opts.textFont or self.lib.sharedSettings.textFont
        label.Color        = opts.textColor and opts.textColor[1] or Color3.new(1,1,1)
        label.Transparency = opts.textColor and opts.textColor[2] or 1
        label.Outline      = opts.textOutline ~= false
        label.OutlineColor = opts.textOutlineColor or Color3.new()
    end
end

-- ─── PUBLIC API ──────────────────────────────────────────────────────────────

-- Ajoute un team config (crée si inexistant, merge si existant)
function Lib:AddTeam(key, overrides)
    local base = defaultTeamConfig()
    if overrides then
        for k, v in pairs(overrides) do base[k] = v end
    end
    self.teamSettings[key] = base
    return base
end

-- Ajoute une instance non-joueur (NPC, Part, Model)
function Lib:AddInstance(instance, options)
    assert(typeof(instance)=="Instance", "AddInstance: arg #1 doit être une Instance")
    if self._cache[instance] then
        warn("EspFusion: instance déjà enregistrée")
        return
    end
    local obj = InstanceObject.new(instance, self, options or {})
    self._cache[instance] = { obj }
    return obj
end

-- Retire une instance manuellement
function Lib:RemoveInstance(instance)
    local objs = self._cache[instance]
    if not objs then return end
    for _, o in ipairs(objs) do o:Destruct() end
    self._cache[instance] = nil
end

-- Charge l'ESP pour tous les joueurs
function Lib:Load()
    assert(not self._loaded, "EspFusion: déjà chargé")

    local function add(player)
        if player == LocalPlayer then return end
        self._cache[player] = {
            EspObject.new(player, self),
            ChamObject.new(player, self),
        }
    end

    local function remove(player)
        local objs = self._cache[player]
        if not objs then return end
        for _, o in ipairs(objs) do o:Destruct() end
        self._cache[player] = nil
    end

    for _, p in ipairs(Players:GetPlayers()) do add(p) end -- fix : index 1, pas 2

    self._connections[1] = Players.PlayerAdded:Connect(add)
    self._connections[2] = Players.PlayerRemoving:Connect(remove)

    -- rainbow
    self._connections[3] = RunService.RenderStepped:Connect(function(dt)
        local s = self.sharedSettings
        if not s.rainbow then return end
        local rb = self._rainbow
        rb.step = (rb.step or 0) + dt
        if rb.step >= 1/60 then
            rb.step = 0
            rb.hue  = (rb.hue + 1/s.rainbowSpeed) % 1
            rb.color = Color3.fromHSV(rb.hue, 0.8, 1)
        end
    end)

    -- camera update
    self._connections[4] = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        Camera = workspace.CurrentCamera
    end)

    self._loaded = true
end

-- Décharge tout
function Lib:Unload()
    assert(self._loaded, "EspFusion: pas encore chargé")

    for index, objs in pairs(self._cache) do
        for _, o in ipairs(objs) do o:Destruct() end
        self._cache[index] = nil
    end

    for _, c in ipairs(self._connections) do
        if c and c.Connected then c:Disconnect() end
    end
    clear(self._connections)

    HighlightContainer:Destroy()

    self._loaded = false
    getgenv().EspFusion = nil
end

-- ─── SINGLETON ───────────────────────────────────────────────────────────────

getgenv().EspFusion = Lib
return Lib

