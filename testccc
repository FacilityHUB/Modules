        BV.Parent = T

        task.spawn(function()
            repeat task.wait()
                local cam = workspace.CurrentCamera
                if not vfly and hum then hum.PlatformStand = true end
                local spd = vfly and vehicleflyspeed or iyflyspeed
                if CONTROL.L+CONTROL.R ~= 0 or CONTROL.F+CONTROL.B ~= 0 or CONTROL.Q+CONTROL.E ~= 0 then
                    SPEED = 50*spd
                else
                    SPEED = 0
                end
                if SPEED ~= 0 then
                    BV.Velocity = ((cam.CFrame.LookVector*(CONTROL.F+CONTROL.B))
                        + ((cam.CFrame * CFrame.new(CONTROL.L+CONTROL.R, (CONTROL.F+CONTROL.B)*0.2, 0)).Position
                           - cam.CFrame.Position)) * SPEED
                        + Vector3.new(0, (CONTROL.Q+CONTROL.E)*SPEED, 0)
                    lCTRL = {F=CONTROL.F,B=CONTROL.B,L=CONTROL.L,R=CONTROL.R,Q=CONTROL.Q,E=CONTROL.E}
                else
                    BV.Velocity = Vector3.zero
                end
                BG.CFrame = cam.CFrame
            until not FLYING
            BG:Destroy(); BV:Destroy()
            if hum then hum.PlatformStand = false end
            pcall(function() workspace.CurrentCamera.CameraType = Enum.CameraType.Custom end)
        end)
    end

    flyKeyDown = UserInputService.InputBegan:Connect(function(inp, proc)
        if proc then return end
        local s = vfly and vehicleflyspeed or iyflyspeed
        if inp.KeyCode == Enum.KeyCode.W then CONTROL.F =  s
        elseif inp.KeyCode == Enum.KeyCode.S then CONTROL.B = -s
        elseif inp.KeyCode == Enum.KeyCode.A then CONTROL.L = -s
        elseif inp.KeyCode == Enum.KeyCode.D then CONTROL.R =  s
        elseif inp.KeyCode == Enum.KeyCode.E and QEfly then CONTROL.Q =  s*2
        elseif inp.KeyCode == Enum.KeyCode.Q and QEfly then CONTROL.E = -s*2
        end
    end)

    flyKeyUp = UserInputService.InputEnded:Connect(function(inp)
        if inp.KeyCode == Enum.KeyCode.W then CONTROL.F = 0
        elseif inp.KeyCode == Enum.KeyCode.S then CONTROL.B = 0
        elseif inp.KeyCode == Enum.KeyCode.A then CONTROL.L = 0
        elseif inp.KeyCode == Enum.KeyCode.D then CONTROL.R = 0
        elseif inp.KeyCode == Enum.KeyCode.E then CONTROL.Q = 0
        elseif inp.KeyCode == Enum.KeyCode.Q then CONTROL.E = 0
        end
    end)

    FLY()
end

local function NOFLY()
    FLYING = false
    if flyKeyDown then flyKeyDown:Disconnect() end
    if flyKeyUp   then flyKeyUp:Disconnect()   end
    local char = Players.LocalPlayer.Character
