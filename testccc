local function hasCrateTypesSelected()
    return getgenv().SelectedCrateTypes and #getgenv().SelectedCrateTypes > 0
end

local function findValidCrate()
    if not hasCrateTypesSelected() then return nil end
    local types   = getgenv().SelectedCrateTypes
    local crateWS = workspace:FindFirstChild("Game Systems")
        and workspace["Game Systems"]:FindFirstChild("Collectibles Workspace")
        and workspace["Game Systems"]["Collectibles Workspace"]:FindFirstChild("PartCrate")
    if not crateWS then return nil end

    local function getCratePos(crate)
        if crate:IsA("BasePart") then return crate.Position end
        if crate:IsA("Model") and crate.PrimaryPart then return crate.PrimaryPart.Position end
        local first = crate:FindFirstChildWhichIsA("BasePart")
        return first and first.Position or nil
    end

    local function matchesSelectedType(crateName)
        for _, prefix in ipairs(types) do
            if crateName:sub(1, #prefix + 1) == (prefix .. "_") then return true end
        end
        return false
    end

    local maxLateral = 0
    for _, l in ipairs(DEPOSIT_LATERAL_OFFSETS) do
        if math.abs(l) > maxLateral then maxLateral = math.abs(l) end
    end
    local maxDist = math.sqrt(DEPOSIT_FORWARD_DISTANCE^2 + maxLateral^2)
    local EXCLUSION_RADIUS = maxDist + 6

    for _, crate in ipairs(crateWS:GetChildren()) do
        if matchesSelectedType(crate.Name) then
            local owner = crate:GetAttribute("Owner")
            if owner and tostring(owner) == LocalPlayer.Name then continue end
            local cratePos = getCratePos(crate)
            if not cratePos then continue end
            if DiamondPlatePos then
                local distToPlate = (cratePos - DiamondPlatePos.Position).Magnitude
                if distToPlate < EXCLUSION_RADIUS then continue end
            end
            return crate
        end
    end
    return nil
end

