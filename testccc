local function recursiveCleanup(parent)
    if not parent then return end
    for _, tycoon in pairs(parent:GetChildren()) do
        if tycoon:IsA("Model") and tycoon:FindFirstChild("PurchasedObjects") then
            for _, obj in pairs(tycoon.PurchasedObjects:GetChildren()) do
                if getgenv().RemoveLaser and obj:FindFirstChild("Laser") then
                    pcall(function() obj.Laser:Destroy() end)
                end
                if getgenv().RemoveElectric and obj.Name == "Electric Fence" then
                    pcall(function() obj:Destroy() end)
                end
            end
        end
        recursiveCleanup(tycoon)
    end
end

