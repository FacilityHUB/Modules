Sec.farmRebirth = Tab.AutoFarm:Section("Rebirth / Cash", "full")

Sec.farmMain:Paragraph({
    Title   = "AutoFarm — BETA",
    Content = "Still in development. If stuck: disable then re-enable the toggle.",
    Icon    = "alert-triangle",
    Style   = "warning",
})

Sec.farmMain:Toggle({ Text = "AutoFarm", Flag = "AutoFarm",
    Callback = function(v)
        getgenv().AutoFarmEnabled = v
        if v then
            applyNoFallDamage()
            enableNoclip()
            StatusUI.setActive("AutoFarm started")
        else
            disableNoclip()
            depositedCrates = {}
            StatusUI.setIdle()
        end
    end })

Sec.farmMain:Toggle({ Text = "AutoBuy Only", Flag = "AutoBuyOnly",
    Callback = function(v)
        getgenv().AutoBuyOnlyEnabled = v
        if v then
            enableNoclip()
            StatusUI.setActive("AutoBuy Only started")
            task.spawn(runAutoBuyOnly)
        else
            disableNoclip()
            StatusUI.setIdle()
        end
    end })

Sec.farmMain:Toggle({ Text = "Status Overlay", Flag = "StatusUIEnabled", Default = true,
    Callback = function(v) getgenv().StatusUIEnabled = v; StatusUI.setVisible(v) end })
    :Gear(function(p)
        -- panneau actif via le toggle, pas d'option sub ici
        p:Label("Toggle shows the floating status panel.", { Style = "dim" })
    end)

Sec.farmMain:Slider({ Text = "Farm Fly Speed", Flag = "FarmFlySpeedSlider", Min = 50, Max = 1000, Suffix = " spd", Default = 300,
    Callback = function(v) getgenv().FarmFlySpeed = v end })

Sec.farmConfig:Dropdown({ Text = "Crate Type", Flag = "CrateTypeSelector",
    Options = {"Air","Land","Naval"}, Multi = true, Default = {"Air","Land","Naval"},
    Callback = function(v) getgenv().SelectedCrateTypes = v end })

Sec.farmConfig:Dropdown({ Text = "Crates per Cycle", Flag = "CrateCycleCountSelector",
    Options = {"2","3"}, Default = "3",
    Callback = function(v) getgenv().CrateCycleCount = tonumber(v) or 3 end })

Sec.farmConfig:Dropdown({ Text = "Money Mode", Flag = "MoneyModeSelector",
    Options = {"Crate","CashCollector","Fusion"}, Default = "Crate",
    Callback = function(v) getgenv().ModeRecupMonay = v or "Crate" end })

Sec.farmRebirth:Split({
    function(left)
        left:Toggle({ Text = "Auto Rebirth", Flag = "AutoRebirth",
            Callback = function(v)
                getgenv().AutoRebirthEnabled = v
                if v then
                    task.spawn(function()
                        while getgenv().AutoRebirthEnabled do
                            pcall(function() ReplicatedStorage:WaitForChild("RebirthEVT", 5):FireServer() end)
                            task.wait(1)
                        end
                    end)
                end
            end })
    end,
    function(right)
        right:Input({ Text = "Cash Target", Flag = "CashTarget",
            Default = tostring(getgenv().CashTarget),
            Placeholder = "0 = unlimited",
            Callback = function(v) getgenv().CashTarget = tonumber(v) or getgenv().CashTarget end })
    end,
})

-- ==========================================
--    UI — WEBHOOK TAB
-- ==========================================
Sec.wbConfig = Tab.Webhook:Section("Discord Webhook", 1)
Sec.wbData   = Tab.Webhook:Section("Data",            2)
Sec.wbReset  = Tab.Webhook:Section("Session",         "full")

Sec.wbConfig:Input({ Text = "Webhook URL", Flag = "WebhookURL",
    Placeholder = "https://discord.com/api/webhooks/...",
    Callback = function(v) getgenv().WebhookURL = v end })

Sec.wbConfig:Input({ Text = "Discord User ID", Flag = "WebhookUserID",
    Placeholder = "123456789... (for ping)",
    Callback = function(v) getgenv().WebhookUserID = v end })

Sec.wbConfig:Toggle({ Text = "Ping User", Flag = "WebhookPingUser",
    Callback = function(v) getgenv().WebhookPingUser = v end })

Sec.wbConfig:Slider({ Text = "Send Every", Flag = "WebhookDelay", Min = 1, Max = 60, Suffix = " min", Default = 5,
    Callback = function(v) getgenv().WebhookDelay = v end })

Sec.wbConfig:Toggle({ Text = "Enable Auto Webhook", Flag = "WebhookEnabled",
    Callback = function(v)
        getgenv().WebhookEnabled = v
        if v then getgenv().LastWebhookSend = tick() end
    end })

Sec.wbData:Dropdown({ Text = "Data to Send", Flag = "WebhookData",
    Options = {"Name","Stats","Farm Activity"},
    Multi = true, Default = {"Stats","Farm Activity"},
    Callback = function(v) getgenv().WebhookData = v end })

Sec.wbData:Button({ Text = "Test Webhook (send now)", Callback = function() task.spawn(Webhook.sendWebhook) end })

Sec.wbReset:Split({
    function(left)
        left:Button({ Text = "Reset Farm Counters", Callback = function()
            getgenv().FarmStats = {
                cratesCollected = 0,
                cratesSold      = 0,
                cyclesCompleted = 0,
                buttonsBought   = 0,
            }
            getgenv().StartStats = Webhook.getCurrentStats()
            getgenv().StartTime  = os.time()
            Library:Success("Reset", "Farm counters cleared.", 3)
        end })
    end,
    function(right)
        right:Label("Resets all session counters and the stat baseline.", { Style = "dim" })
    end,
})

-- ==========================================
--    UI — EXTRA (Useless) TAB
-- ==========================================
Sec.extraFling  = Tab.Extra:Section("Fling",  1)
Sec.extraCamera = Tab.Extra:Section("Camera", 2)

Sec.extraFling:Toggle({ Text = "Walk Fling", Flag = "WalkFling",
    Callback = function(v)
        if v then
            if getgenv().SpinFlingEnabled then
                Fling.stopSpinFling()
                Library:Warn("Spin Fling disabled", "Only one fling mode at a time.", 3)
            end
            Fling.startWalkFling()
            StatusUI.setActive("Walk Fling active")
        else
            Fling.stopWalkFling()
            StatusUI.setIdle()
        end
    end })

Sec.extraFling:Toggle({ Text = "Anti-Fling", Flag = "AntiFling",
    Callback = function(v) if v then Fling.startAntiFling() else Fling.stopAntiFling() end end })

Sec.extraCamera:Toggle({ Text = "Custom FOV", Flag = "CustomFOV",
    Callback = function(v)
        getgenv().CustomFOVEnabled = v
        if v then Visual.startCustomFOV() else Visual.stopCustomFOV() end
    end })
    :Gear(function(p)
        p:Slider({ Text = "FOV Value", Flag = "CustomFOVValue", Min = 30, Max = 120, Suffix = "°", Default = 70,
            Callback = function(v) getgenv().CustomFOVValue = v; if getgenv().CustomFOVEnabled then Camera.FieldOfView = v end end })
    end)

Sec.extraCamera:Toggle({ Text = "Max Zoom", Flag = "MaxZoom",
    Callback = function(v)
        getgenv().MaxZoomEnabled = v
        if v then Visual.startMaxZoom() else Visual.stopMaxZoom() end
    end })
    :Gear(function(p)
        p:Slider({ Text = "Zoom Distance", Flag = "MaxZoomValue", Min = 50, Max = 2000, Suffix = " studs", Default = 400,
            Callback = function(v) getgenv().MaxZoomValue = v; if getgenv().MaxZoomEnabled then Visual.applyMaxZoom() end end })
    end)

