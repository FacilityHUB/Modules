-- ==========================================
--    SHARED TARGETING ENGINE
-- ==========================================
local TargetingEngine = {}
do
    function TargetingEngine.findTargetPart(player, partName)
        if not player.Character or not partName then return nil end
        local part = player.Character:FindFirstChild(partName, true)
        if part and part:IsA("BasePart") then return part end
        return nil
    end

    function TargetingEngine.isInFOV(targetPosition, fovRadius)
        local screenPos, isVisible = Camera:WorldToViewportPoint(targetPosition)
        if not isVisible then return false end
        local mousePos = Vector2.new(Mouse.X, Mouse.Y)
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        return dist <= fovRadius
    end

    function TargetingEngine.isAlive(player)
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        return hum and hum.Health > 0
    end

    function TargetingEngine.passesTeamCheck(player)
        if not getgenv().FacilityTargeting.TeamCheck then return true end
        local localFaction = LocalPlayer:FindFirstChild("PersonalFactionData")
            and LocalPlayer.PersonalFactionData:FindFirstChild("PersonalFaction")
        local targetFaction = player:FindFirstChild("PersonalFactionData")
            and player.PersonalFactionData:FindFirstChild("PersonalFaction")
        local sameFaction = localFaction and targetFaction
            and localFaction.Value == targetFaction.Value
        local hasTeammateLabel = player.Character
            and player.Character:FindFirstChild("HumanoidRootPart")
            and player.Character.HumanoidRootPart:FindFirstChild("TeammateLabel")
        local sameRobloxTeam = (player.Team == LocalPlayer.Team)
        return not (sameFaction or hasTeammateLabel or sameRobloxTeam)
    end

    function TargetingEngine.passesWallCheck(player, targetPart, originPos)
        if not getgenv().FacilityTargeting.WallCheck then return true end
        local distance = (originPos - targetPart.Position).Magnitude
        local ray = workspace:FindPartOnRayWithIgnoreList(
            Ray.new(originPos, (targetPart.Position - originPos).Unit * distance),
            { LocalPlayer.Character, Camera }
        )
        return ray and ray:IsDescendantOf(player.Character)
    end

    function TargetingEngine.getPlayerClosestToCursor()
        local config = getgenv().FacilityTargeting
        local nearest = nil
        local smallestDistance = math.huge
        local mousePos = Vector2.new(Mouse.X, Mouse.Y)
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if config.AliveCheck and not TargetingEngine.isAlive(player) then continue end
            local part = TargetingEngine.findTargetPart(player, config.SelectedPart)
            if not part then continue end
            local distFromPlayer = (Camera.CFrame.Position - part.Position).Magnitude
            if distFromPlayer > config.MaxDistance then continue end
            if not TargetingEngine.passesTeamCheck(player) then continue end
            if not TargetingEngine.passesWallCheck(player, part, Camera.CFrame.Position) then continue end
            if config.FovCheck and not TargetingEngine.isInFOV(part.Position, config.FovSize) then continue end
            local screenPos = Camera:WorldToViewportPoint(part.Position)
            local distToCursor = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
            if distToCursor < smallestDistance then nearest = player; smallestDistance = distToCursor end
        end
        return nearest
    end

    function TargetingEngine.getPlayerClosestToCursorFromOrigin(origin)
        local config = getgenv().FacilityTargeting
        local nearest = nil
        local smallestDistance = math.huge
        local mousePos = Vector2.new(Mouse.X, Mouse.Y)
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if config.AliveCheck and not TargetingEngine.isAlive(player) then continue end
            if player.Character and player.Character:FindFirstChildOfClass("ForceField") then continue end
            local part = TargetingEngine.findTargetPart(player, config.SelectedPart)
            if not part then continue end
            local distFromOrigin = (origin - part.Position).Magnitude
            if distFromOrigin > config.MaxDistance then continue end
            if not TargetingEngine.passesTeamCheck(player) then continue end
            if not TargetingEngine.passesWallCheck(player, part, origin) then continue end
            if config.FovCheck and not TargetingEngine.isInFOV(part.Position, config.FovSize) then continue end
            local screenPos = Camera:WorldToViewportPoint(part.Position)
            local distToCursor = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
            if distToCursor < smallestDistance then nearest = part; smallestDistance = distToCursor end
        end
        return nearest
    end
end

-- ==========================================
--    AIMBOT SYSTEM
-- ==========================================
do
    local AIM_KEY_MAP = {
        ["MouseButton1"]  = { type = Enum.UserInputType.MouseButton1, key = nil },
        ["MouseButton2"]  = { type = Enum.UserInputType.MouseButton2, key = nil },
        ["MouseButton3"]  = { type = Enum.UserInputType.MouseButton3, key = nil },
        ["E"]             = { type = Enum.UserInputType.Keyboard,     key = Enum.KeyCode.E },
        ["F"]             = { type = Enum.UserInputType.Keyboard,     key = Enum.KeyCode.F },
        ["Q"]             = { type = Enum.UserInputType.Keyboard,     key = Enum.KeyCode.Q },
        ["LeftShift"]     = { type = Enum.UserInputType.Keyboard,     key = Enum.KeyCode.LeftShift },
        ["LeftControl"]   = { type = Enum.UserInputType.Keyboard,     key = Enum.KeyCode.LeftControl },
        ["LeftAlt"]       = { type = Enum.UserInputType.Keyboard,     key = Enum.KeyCode.LeftAlt },
    }

    local function inputMatchesAimKey(input)
        local mapping = AIM_KEY_MAP[getgenv().FacilityAimbot.AimKey]
        if not mapping then return false end
        if input.UserInputType ~= mapping.type then return false end
        if mapping.key and input.KeyCode ~= mapping.key then return false end
        return true
    end

    local FOV = Drawing.new("Circle")
    FOV.Filled    = false
    FOV.NumSides  = 64
    FOV.Visible   = false
    FOV.Position  = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    local function alignCameraToTarget(targetPosition)
        local sensitivity = getgenv().FacilityAimbot.Sensitivity
        local currentCF = Camera.CFrame
        local targetCF = CFrame.new(currentCF.Position, targetPosition)
        Camera.CFrame = currentCF:Lerp(targetCF, sensitivity)
    end

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if not getgenv().FacilityAimbot.Enabled then return end
        if not inputMatchesAimKey(input) then return end
        if getgenv().FacilityAimbot.ToggleMode then
            getgenv().FacilityAimbot._active = not getgenv().FacilityAimbot._active
        else
            getgenv().FacilityAimbot._active = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not getgenv().FacilityAimbot.Enabled then return end
        if not inputMatchesAimKey(input) then return end
        if getgenv().FacilityAimbot.ToggleMode then return end
        getgenv().FacilityAimbot._active = false
    end)

    RunService.RenderStepped:Connect(function()
        local targeting = getgenv().FacilityTargeting
        local aimbot   = getgenv().FacilityAimbot
        local silent   = getgenv().FacilitySilentAim

        FOV.Position  = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FOV.Thickness = targeting.FovThickness
        FOV.Radius    = targeting.FovSize

        local anyEnabled = aimbot.Enabled or silent.Enabled
        FOV.Visible = targeting.FovVisible and anyEnabled

        if not anyEnabled then FOV.Color = targeting.OffColor; return end

        if aimbot.Enabled and aimbot._active then
            local target = TargetingEngine.getPlayerClosestToCursor()
            if target then
                local part = TargetingEngine.findTargetPart(target, targeting.SelectedPart)
                if part then
                    FOV.Color = targeting.LockColor
                    alignCameraToTarget(part.Position)
                    return
                end
            end
        end

        FOV.Color = targeting.FovColor
    end)
end

-- ==========================================
--    SILENT AIM SYSTEM
-- ==========================================
do
    local function tryHookSilentAim()
        if getgenv().FacilitySilentAim._hooked then return true end
        if not (hookfunction and require) then
            Library:Error("Silent Aim", "hookfunction or require not supported by your executor.", 8)
            return false
        end
        local bulletFireSystem = ReplicatedStorage:FindFirstChild("BulletFireSystem")
        if not bulletFireSystem then
            Library:Error("Silent Aim", "BulletFireSystem not found. Game may have updated.", 8)
            return false
        end
        local fastCast = bulletFireSystem:FindFirstChild("FastCastRedux")
        local activeCastModule = fastCast and fastCast:FindFirstChild("ActiveCast")
        if not activeCastModule then
            Library:Error("Silent Aim", "ActiveCast module not found.", 8)
            return false
        end
        local ok, activeCast = pcall(require, activeCastModule)
        if not ok then
            Library:Error("Silent Aim", "Could not access ActiveCast: " .. tostring(activeCast), 8)
            return false
        end
        local gs  = workspace:FindFirstChild("Game Systems")
        local lps = workspace:FindFirstChild("LocalPartStorage")
        if not (gs and lps) then
            Library:Error("Silent Aim", "Game Systems or LocalPartStorage missing.", 8)
            return false
        end
        local oldNew
        oldNew = hookfunction(rawget(activeCast, "new"), function(_, origin, dir, vel, ...)
            if getgenv().FacilitySilentAim.Enabled then
                local targetPart = TargetingEngine.getPlayerClosestToCursorFromOrigin(origin)
                if targetPart then
                    local newDir = targetPart.Position - origin
                    return oldNew(_, origin, newDir, newDir.Unit * 9e9, ...)
                end
            end
            return oldNew(_, origin, dir, vel, ...)
        end)
        getgenv().FacilitySilentAim._hooked = true
        return true
    end

    task.spawn(function()
        task.wait(2)
        tryHookSilentAim()
    end)
end

-- ==========================================
--    HITBOX EXTENDER SYSTEM
-- ==========================================
do
    local hitboxData = getgenv().FacilityHitbox._originalData

    local function backupPart(part, playerName)
        if hitboxData[playerName] then return end
        hitboxData[playerName] = {
            part         = part,
            Size         = part.Size,
            Transparency = part.Transparency,
            Color        = part.Color,
            Material     = part.Material,
            CanCollide   = part.CanCollide,
            Massless     = part.Massless,
        }
    end

    local function restorePart(playerName)
        local data = hitboxData[playerName]
        if not data then return end
        local part = data.part
        if part and part.Parent then
            pcall(function()
                part.Size         = data.Size
                part.Transparency = data.Transparency
                part.Color        = data.Color
                part.Material     = data.Material
                part.CanCollide   = data.CanCollide
                part.Massless     = data.Massless
            end)
        end
        hitboxData[playerName] = nil
    end

    local function restoreAll()
        for playerName in pairs(hitboxData) do restorePart(playerName) end
    end

    local function shouldSkipPlayer(player)
        local cfg = getgenv().FacilityHitbox
        if cfg.RespectWhitelist then
            local lowerName = player.Name:lower()
            for _, name in ipairs(getgenv().ESPWhitelist or {}) do
                if tostring(name):lower() == lowerName then return true end
            end
        end
        if cfg.RespectTeam then
            local localFaction = LocalPlayer:FindFirstChild("PersonalFactionData")
                and LocalPlayer.PersonalFactionData:FindFirstChild("PersonalFaction")
            local targetFaction = player:FindFirstChild("PersonalFactionData")
                and player.PersonalFactionData:FindFirstChild("PersonalFaction")
            local sameFaction = localFaction and targetFaction
                and localFaction.Value == targetFaction.Value
            local sameRobloxTeam = (player.Team == LocalPlayer.Team)
            if sameFaction or sameRobloxTeam then return true end
        end
        return false
    end

    local function applyHitbox(player)
        local cfg  = getgenv().FacilityHitbox
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then restorePart(player.Name); return end
        local part = char:FindFirstChild(cfg.TargetPart)
        if not (part and part:IsA("BasePart")) then return end
        if shouldSkipPlayer(player) then restorePart(player.Name); return end
        backupPart(part, player.Name)
        local sz = cfg.Size
        part.Size         = Vector3.new(sz, sz, sz)
        part.Transparency = cfg.Transparency
        part.Color        = cfg.Color
        part.Material     = Enum.Material.ForceField
        part.Massless     = true
        if cfg.DisableCollide then part.CanCollide = false end
    end

    local accumulator = 0
    local UPDATE_INTERVAL = 0.1
    RunService.Heartbeat:Connect(function(dt)
        accumulator = accumulator + dt
        if accumulator < UPDATE_INTERVAL then return end
        accumulator = 0
        if not getgenv().FacilityHitbox.Enabled then
            if next(hitboxData) then restoreAll() end
            return
        end
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then applyHitbox(player) end
        end
    end)

    Players.PlayerRemoving:Connect(function(player) hitboxData[player.Name] = nil end)

    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function() hitboxData[player.Name] = nil end)
    end)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            p.CharacterAdded:Connect(function() hitboxData[p.Name] = nil end)
        end
    end
end

