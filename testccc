-- ==========================================
local function startAutoBuy()
    while true do
        if not getgenv().AutoFarmEnabled then break end
        local folder  = findTargetFolder()
        local buttons = folder and getAvailableButtons(folder) or {}
        local cashReached = isCashTargetReached()

        if cashReached and #buttons > 0 then
            StatusUI.setActive("AutoBuy mode (cash target reached)")
            for _, btn in ipairs(buttons) do
                if not getgenv().AutoFarmEnabled then return end
                teleportToButton(btn)
            end
        elseif cashReached and #buttons == 0 then
            StatusUI.setActive("Cash target reached - waiting for buttons")
            if not safeWait(2) then break end
        elseif #buttons > 0 then
            for _, btn in ipairs(buttons) do
                if not getgenv().AutoFarmEnabled then return end
                teleportToButton(btn)
            end
        else
            local mode = getgenv().ModeRecupMonay
            if     mode == "Crate"         then runModeCrate()
            elseif mode == "CashCollector" then runModeCashCollector()
            elseif mode == "Fusion"        then runModeFusion()
            end
        end

        if not safeWait(0.5) then break end
    end
end

local function runAutoBuyOnly()
    while getgenv().AutoBuyOnlyEnabled do
        local folder  = findTargetFolder()
        local buttons = folder and getAvailableButtons(folder) or {}
        if #buttons > 0 then
            for _, btn in ipairs(buttons) do
                if not getgenv().AutoBuyOnlyEnabled then return end
                teleportToButton(btn)
            end
        end
        if not getgenv().AutoBuyOnlyEnabled then return end
        task.wait(1)
    end
end

local function monitorAutoBuy()
    if isMonitorRunning then return end
    isMonitorRunning = true
    while true do
        if getgenv().AutoFarmEnabled then
            cacheSpawnVisualizer()
            startAutoBuy()
            pcall(function()
                local r = waitForRoot(2)
                local spawnCFrame = getSpawnVisualizerCFrame()
                if r and spawnCFrame then r.CFrame = spawnCFrame end
            end)
        end
        task.wait(1)
    end
end

-- ==========================================
--    WEBHOOK SYSTEM
-- ==========================================
local Webhook = (function()
    local function commaFormat(n)
        local s = tostring(math.floor(tonumber(n) or 0))
        return s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    end

    local function abbreviate(n)
        n = tonumber(n) or 0
        local abbrev = {{1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"}}
        for _, v in ipairs(abbrev) do
            if n >= v[1] then return string.format("%.2f%s", n / v[1], v[2]) end
        end
        return tostring(n)
    end

    local function getSessionTime()
        local seconds = os.time() - (getgenv().StartTime or os.time())
        local hours = math.floor(seconds / 3600)
        local mins  = math.floor((seconds % 3600) / 60)
        return string.format("%dh %02dm", hours, mins)
    end

    local function getTycoonCompletion()
        local ok, val = pcall(function()
            return LocalPlayer.PlayerGui.UI.Container.HUD.Menu.HUD.Left
                .TycoonCompletion.Bar.BarProgressAmount.Text
        end)
        return (ok and val) or "N/A"
    end

    local function getCurrentStats()
        return {
            Cash             = getLeaderstatValue("Cash", 0),
            Kills            = getLeaderstatValue("Kills", 0),
            Deaths           = getLeaderstatValue("Deaths", 0),
            Medals           = getLeaderstatValue("Medals", 0),
            Rebirths         = getLeaderstatValue("Rebirths", 0),
            TycoonCompletion = getTycoonCompletion(),
        }
    end

    local function formatGain(current, start, useAbbrev)
        local diff = (tonumber(current) or 0) - (tonumber(start) or 0)
        if useAbbrev then
            return string.format("%s (+%s)", abbreviate(current), abbreviate(diff))
        else
            return string.format("%s (+%d)", commaFormat(current), diff)
        end
    end

    local function sendWebhook()
        local url = getgenv().WebhookURL
        if not url or url == "" or not url:find("discord.com/api/webhooks/") then return end
        local httpreq = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
        if type(httpreq) ~= "function" then
            warn("[FacilityHub] No HTTP request function available for webhook")
            return
        end
        local selected = {}
        for _, v in ipairs(getgenv().WebhookData or {}) do selected[v] = true end
        if not getgenv().StartStats then getgenv().StartStats = getCurrentStats() end
        local startStats = getgenv().StartStats
        local desc = "### Facility Hub - War Tycoon\n"
        if selected["Name"] then
            desc = desc .. string.format("\n👤 **Player:** ||%s||\n", LocalPlayer.Name)
        end
        if selected["Stats"] then
            local cur = getCurrentStats()
            desc = desc .. "\n📊 **Stats**\n"
            desc = desc .. string.format("💰 Cash: `%s`\n", formatGain(cur.Cash, startStats.Cash, true))
            desc = desc .. string.format("♻️ Rebirths: `%s`\n", formatGain(cur.Rebirths, startStats.Rebirths, false))
            desc = desc .. string.format("⚔️ Kills: `%s`\n", formatGain(cur.Kills, startStats.Kills, false))
            desc = desc .. string.format("💀 Deaths: `%s`\n", formatGain(cur.Deaths, startStats.Deaths, false))
            desc = desc .. string.format("🎖️ Medals: `%s`\n", formatGain(cur.Medals, startStats.Medals, false))
            desc = desc .. string.format("🏗️ Tycoon Completion: `%s`\n", cur.TycoonCompletion)
        end
        if selected["Farm Activity"] then
            local fs = getgenv().FarmStats
            desc = desc .. "\n🚜 **Farm Activity** (this session)\n"
            desc = desc .. string.format("📦 Crates collected: `%d`\n", fs.cratesCollected)
            desc = desc .. string.format("💵 Crates sold: `%d`\n", fs.cratesSold)
            desc = desc .. string.format("🎯 Cycles completed: `%d`\n", fs.cyclesCompleted)
            desc = desc .. string.format("🛒 Buttons bought: `%d`\n", fs.buttonsBought)
        end
        local payload = {
            embeds = {{
                description = desc,
                color = tonumber("FF8C28", 16),
                footer = {
                    text = string.format("Facility Hub • Session: %s • %s",
                        getSessionTime(), os.date("%x %X"))
                }
            }}
        }
        if getgenv().WebhookPingUser then
            local uid = getgenv().WebhookUserID
            payload.content = (uid and uid ~= "") and ("<@" .. uid .. ">") or "@everyone"
        end
        task.spawn(function()
            pcall(function()
                httpreq({
                    Url     = url,
                    Method  = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body    = game:GetService("HttpService"):JSONEncode(payload)
                })
            end)
        end)
    end

    task.spawn(function()
        waitForLeaderstats(30)
        task.wait(2)
        getgenv().StartStats = getCurrentStats()
        getgenv().StartTime  = os.time()
    end)

    task.spawn(function()
        while true do
            task.wait(60)
            if not getgenv().WebhookEnabled then continue end
            local delayMins = math.max(getgenv().WebhookDelay or 5, 1)
            if not getgenv().LastWebhookSend or getgenv().LastWebhookSend == 0 then
                getgenv().LastWebhookSend = tick()
            end
            if tick() - getgenv().LastWebhookSend >= delayMins * 60 then
                sendWebhook()
                getgenv().LastWebhookSend = tick()
            end
        end
