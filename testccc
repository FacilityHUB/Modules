local ESP = (function()
    local ESP = {}
        local floor = math.floor
        local round = math.round
        local clear = table.clear
        local unpack = table.unpack
        local create = table.create
        local fromMatrix = CFrame.fromMatrix

        local container = Instance.new("Folder")
        pcall(function()
            container.Parent = (gethui and gethui()) or CoreGui
        end)
        if not container.Parent then
            container.Parent = LocalPlayer:WaitForChild("PlayerGui")
        end

        local viewportSize = Camera.ViewportSize
        Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            viewportSize = Camera.ViewportSize
        end)

        local VERTICES = {
            Vector3.new(-1, -1, -1), Vector3.new(-1, 1, -1),
            Vector3.new(-1, 1,  1), Vector3.new(-1, -1, 1),
            Vector3.new( 1, -1, -1), Vector3.new( 1, 1, -1),
            Vector3.new( 1, 1,  1), Vector3.new( 1, -1, 1),
        }

        local function isBodyPart(name)
            return name == "Head" or name:find("Torso") or name:find("Leg") or name:find("Arm")
        end

        local function getBoundingBox(parts)
            local min, max
            for i = 1, #parts do
                local part = parts[i]
                local cframe, size = part.CFrame, part.Size
                min = (min or cframe.Position):Min((cframe - size * 0.5).Position)
                max = (max or cframe.Position):Max((cframe + size * 0.5).Position)
            end
            local center = (min + max) * 0.5
            return CFrame.new(center, Vector3.new(center.X, center.Y, max.Z)), max - min
        end

        local function worldToScreen(world)
            local screen, inBounds = Camera:WorldToViewportPoint(world)
            return Vector2.new(screen.X, screen.Y), inBounds, screen.Z
        end

        local function calculateCorners(cframe, size)
            local corners = create(#VERTICES)
            for i = 1, #VERTICES do
                corners[i] = worldToScreen((cframe + size * 0.5 * VERTICES[i]).Position)
            end
            local minV = viewportSize:Min(unpack(corners))
            local maxV = Vector2.zero:Max(unpack(corners))
            return {
                corners     = corners,
                topLeft     = Vector2.new(floor(minV.X), floor(minV.Y)),
                topRight    = Vector2.new(floor(maxV.X), floor(minV.Y)),
                bottomLeft  = Vector2.new(floor(minV.X), floor(maxV.Y)),
                bottomRight = Vector2.new(floor(maxV.X), floor(maxV.Y)),
            }
        end

        local EspObject = {}
        EspObject.__index = EspObject

        function EspObject.new(player)
            local self = setmetatable({}, EspObject)
            self.player = player
            self.bin = {}
            self.charCache = {}
            self.childCount = 0

            local function makeDrawing(class, props)
                local d = Drawing.new(class)
                for k, v in pairs(props) do pcall(function() d[k] = v end) end
                self.bin[#self.bin + 1] = d
                return d
            end

            self.box      = makeDrawing("Square", { Thickness = 1, Filled = false, Visible = false, Color = Color3.new(1, 0, 0) })
            self.boxOut   = makeDrawing("Square", { Thickness = 3, Filled = false, Visible = false, Color = Color3.new(0, 0, 0) })
            self.name     = makeDrawing("Text",   { Center = true, Size = 13, Font = 2, Outline = true, Visible = false, Color = Color3.new(1, 1, 1) })
            self.distance = makeDrawing("Text",   { Center = true, Size = 13, Font = 2, Outline = true, Visible = false, Color = Color3.new(1, 1, 1) })
            self.tracer   = makeDrawing("Line",   { Thickness = 1, Visible = false, Color = Color3.new(1, 0, 0) })

            self.highlight = Instance.new("Highlight")
            self.highlight.Enabled = false
            self.highlight.FillColor = Color3.new(1, 0, 0)
            self.highlight.FillTransparency = 0.5
            self.highlight.OutlineColor = Color3.new(0, 0, 0)
            self.highlight.OutlineTransparency = 0
            self.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            self.highlight.Parent = container

            self.connection = RunService.Heartbeat:Connect(function() self:Render() end)
            return self
        end

        function EspObject:Destroy()
            if self.connection then self.connection:Disconnect() end
            for i = 1, #self.bin do pcall(function() self.bin[i]:Remove() end) end
            if self.highlight then self.highlight:Destroy() end
            clear(self)
        end

        function EspObject:Render()
            local function hideAll()
                self.box.Visible      = false
                self.boxOut.Visible   = false
                self.name.Visible     = false
                self.distance.Visible = false
                self.tracer.Visible   = false
                self.highlight.Enabled = false
            end

            if not getgenv().ESPEnabled then return hideAll() end

            local player = self.player
            if not player or not player.Parent then return hideAll() end

            local whitelist = getgenv().ESPWhitelist or {}
            local lowerName = player.Name:lower()
            for _, name in ipairs(whitelist) do
                if tostring(name):lower() == lowerName then return hideAll() end
            end

            local character = player.Character
            if not character then return hideAll() end

            local head = character:FindFirstChild("Head")
            local hum  = character:FindFirstChildOfClass("Humanoid")
            if not (head and hum and hum.Health > 0) then return hideAll() end

            local screenPos, onScreen, depth = worldToScreen(head.Position)

            if depth > (getgenv().ESPMaxDistance or 5000) then return hideAll() end

            if getgenv().ESPChams then
                self.highlight.Enabled = true
                self.highlight.Adornee = character
            else
                self.highlight.Enabled = false
            end

            if not onScreen then
                self.box.Visible      = false
                self.boxOut.Visible   = false
                self.name.Visible     = false
                self.distance.Visible = false
                self.tracer.Visible   = false
                return
            end

            local cache = self.charCache
            local children = character:GetChildren()
            if not cache[1] or self.childCount ~= #children then
                clear(cache)
                for i = 1, #children do
                    local part = children[i]
                    if part:IsA("BasePart") and isBodyPart(part.Name) then
                        cache[#cache + 1] = part
                    end
                end
                self.childCount = #children
            end
            if #cache == 0 then return hideAll() end

            local corners = calculateCorners(getBoundingBox(cache))

            if getgenv().ESPBox then
                self.boxOut.Visible = true
                self.boxOut.Position = corners.topLeft
                self.boxOut.Size = corners.bottomRight - corners.topLeft
                self.box.Visible = true
                self.box.Position = corners.topLeft
                self.box.Size = corners.bottomRight - corners.topLeft
            else
                self.box.Visible = false
                self.boxOut.Visible = false
            end

            if getgenv().ESPName then
                self.name.Visible = true
                self.name.Text = player.DisplayName
                self.name.Position = (corners.topLeft + corners.topRight) * 0.5
                    - Vector2.new(0, self.name.TextBounds.Y + 2)
            else
                self.name.Visible = false
            end

            if getgenv().ESPDistance then
                self.distance.Visible = true
                self.distance.Text = round(depth) .. " studs"
                self.distance.Position = (corners.bottomLeft + corners.bottomRight) * 0.5
                    + Vector2.new(0, 2)
            else
                self.distance.Visible = false
            end

            if getgenv().ESPTracer then
                self.tracer.Visible = true
                self.tracer.From = Vector2.new(viewportSize.X * 0.5, viewportSize.Y)
                self.tracer.To = (corners.bottomLeft + corners.bottomRight) * 0.5
            else
                self.tracer.Visible = false
            end
        end

        local objects = {}

        function ESP.AddPlayer(player)
            if player == LocalPlayer then return end
            if objects[player] then return end
            objects[player] = EspObject.new(player)
        end

        function ESP.RemovePlayer(player)
            if objects[player] then
                objects[player]:Destroy()
                objects[player] = nil
            end
        end

        function ESP.Load()
            for _, p in ipairs(Players:GetPlayers()) do ESP.AddPlayer(p) end
            Players.PlayerAdded:Connect(ESP.AddPlayer)
            Players.PlayerRemoving:Connect(ESP.RemovePlayer)
        end

        ESP.Load()

        return ESP
end)()

