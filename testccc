-- ── Vehicle Fly ───────────────────────────
local carFlyControl  = { f=0, b=0, l=0, r=0 }

local function startCarFlying()
    local char = Players.LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart
    if not seat then
        -- tente de trouver un siège même sans être assis
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e9,9e9,9e9); bv.Velocity = Vector3.zero
        bv.Parent = root
        local bg = Instance.new("BodyGyro")
        bg.P = 9e4; bg.MaxTorque = Vector3.new(9e9,9e9,9e9); bg.CFrame = root.CFrame
        bg.Parent = root
        repeat task.wait()
            local cam = workspace.CurrentCamera
            local mv = Vector3.new(carFlyControl.l+carFlyControl.r, 0, -(carFlyControl.f+carFlyControl.b))
            bv.Velocity = (cam.CFrame - cam.CFrame.Position):VectorToWorldSpace(mv) * (vehicleflyspeed*50)
            bg.CFrame = cam.CFrame
        until not getgenv().CarFlyEnabled
        bv:Destroy(); bg:Destroy()
        return
    end

    local bg = Instance.new("BodyGyro", seat)
    bg.P = 9e4; bg.MaxTorque = Vector3.new(9e9,9e9,9e9); bg.CFrame = seat.CFrame
    local bv = Instance.new("BodyVelocity", seat)
    bv.MaxForce = Vector3.new(9e9,9e9,9e9)

    repeat task.wait()
        local cam = workspace.CurrentCamera
        local mv = (cam.CFrame.LookVector * (carFlyControl.f+carFlyControl.b))
            + ((cam.CFrame * CFrame.new(carFlyControl.l+carFlyControl.r,
               (carFlyControl.f+carFlyControl.b)*0.2, 0)).Position - cam.CFrame.Position)
        bv.Velocity = mv * (vehicleflyspeed*50)
        bg.CFrame   = seat.CFrame
    until not getgenv().CarFlyEnabled

    if bg and bg.Parent then bg:Destroy() end
    if bv and bv.Parent then bv:Destroy() end
end

-- ── Vehicle Noclip ────────────────────────
local carNoclipParts = {}

local function enableCarNoclip()
    carNoclipParts = {}
    local char = Players.LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart
    if not seat then return end
    local vehicleModel = seat.Parent
    while vehicleModel and vehicleModel.ClassName ~= "Model" do
        vehicleModel = vehicleModel.Parent
    end
    if not vehicleModel then return end
    for _, v in pairs(vehicleModel:GetDescendants()) do
        if v:IsA("BasePart") and v.CanCollide then
            table.insert(carNoclipParts, v)
            v.CanCollide = false
        end
    end
end

local function disableCarNoclip()
    for _, v in pairs(carNoclipParts) do
        if v and v.Parent then
            pcall(function() v.CanCollide = true end)
        end
    end
    carNoclipParts = {}
end

-- ── Swim ──────────────────────────────────
local swimming    = false
local oldGrav     = workspace.Gravity
local swimbeat    = nil
local gravReset   = nil

local function startSwim(speaker)
    if swimming then return end
    speaker = speaker or Players.LocalPlayer
    local char = speaker.Character
    local hum  = char and char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end

    oldGrav = workspace.Gravity
    workspace.Gravity = 0
    swimming = true

    gravReset = hum.Died:Connect(function()
        workspace.Gravity = oldGrav
        swimming = false
        if swimbeat then swimbeat:Disconnect(); swimbeat = nil end
    end)

    local enums = Enum.HumanoidStateType:GetEnumItems()
    table.remove(enums, table.find(enums, Enum.HumanoidStateType.None))
    for _, v in pairs(enums) do hum:SetStateEnabled(v, false) end
    hum:ChangeState(Enum.HumanoidStateType.Swimming)

    swimbeat = RunService.Heartbeat:Connect(function()
        pcall(function()
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local moving = hum.MoveDirection ~= Vector3.zero
                    or UserInputService:IsKeyDown(Enum.KeyCode.Space)
                if not moving then root.Velocity = Vector3.zero end
            end
        end)
    end)
end

local function stopSwim(speaker)
    if not swimming then return end
    speaker = speaker or Players.LocalPlayer
    local char = speaker.Character
    local hum  = char and char:FindFirstChildWhichIsA("Humanoid")

    workspace.Gravity = oldGrav
    swimming = false
    if gravReset then gravReset:Disconnect(); gravReset = nil end
    if swimbeat  then swimbeat:Disconnect();  swimbeat  = nil end

    if hum then
        local enums = Enum.HumanoidStateType:GetEnumItems()
        table.remove(enums, table.find(enums, Enum.HumanoidStateType.None))
        for _, v in pairs(enums) do hum:SetStateEnabled(v, true) end
    end
end

