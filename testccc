local function interactWithCashCollector()
    local tycoon = findPlayerTycoon()
    if not tycoon or not tycoon:FindFirstChild("Essentials") then return end
    pcall(function()
        local essentials = tycoon.Essentials
        local collectorParts = essentials:FindFirstChild("CollectorParts")
