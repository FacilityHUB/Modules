local function isButtonValid(instance)
    local neon = instance:FindFirstChild("Neon")
    if not (neon and neon:IsA("BasePart")) then return false end
    local parent = neon.Parent
    for _, color in ipairs(AUTO_BUY_COLORS) do
        if color == "Rebirth" and neon.Color == Color3.fromRGB(255, 255, 0) then
            local rawReq = parent and parent:GetAttribute("RebirthRequirement")
            local rawPr  = getLeaderstatValue("Rebirths", 0)
            local req = tonumber(rawReq)
            local pr  = tonumber(rawPr) or 0
            if req and req <= pr then return true end
        elseif color == "Vert" and neon.Color == Color3.fromRGB(0, 255, 0) then
            return true
        elseif color == "Bleu" and neon.Color == Color3.fromRGB(4, 175, 235) then
            return true
        end
    end
    return false
end

local function getAvailableButtons(folder)
    local buttons = {}
    if not folder then return buttons end
    for _, child in ipairs(folder:GetChildren()) do
        if isButtonValid(child) then table.insert(buttons, child) end
