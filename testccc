local function doFallbackTeleport()
    local positions = buildFallbackTeleports()
    if #positions == 0 then
        StatusUI.setActive("Searching for crates...")
        safeWait(2)
        return
    end
    local root = waitForRoot()
    if not root then return end
    StatusUI.setActive("Searching for crates (map tour)")

    for i, pos in ipairs(positions) do
        if not getgenv().AutoFarmEnabled then return end
        root.CFrame = pos
        local elapsed = 0
        local checkInterval = 0.25
        while elapsed < TELEPORT_DELAY do
            if not getgenv().AutoFarmEnabled then return end
            if findValidCrate() then
                StatusUI.setActive("Crate detected - tour interrupted")
                return
            end
            local waited = task.wait(checkInterval)
            elapsed = elapsed + (waited or checkInterval)
        end
    end
end

local function teleportToButton(button)
    if not button then return end
    local neon = button:FindFirstChild("Neon")
    if not (neon and neon:IsA("BasePart")) then return end
    local root = waitForRoot()
    if not root then return end
    local btnName = button.Name or "?"
    StatusUI.setActive("AutoBuy - " .. btnName)
    local elapsed = 0
    local wasValid = button.Parent and isButtonValid(button)
    while (getgenv().AutoFarmEnabled or getgenv().AutoBuyOnlyEnabled)
        and button.Parent
        and isButtonValid(button)
        and elapsed < 5 do
        pcall(function() root.CFrame = neon.CFrame + Vector3.new(0, 5, 0) end)
        elapsed = elapsed + task.wait(0.5)
    end
    if wasValid and not (button.Parent and isButtonValid(button)) then
        getgenv().FarmStats.buttonsBought = getgenv().FarmStats.buttonsBought + 1
    end
end

local function tweenRootTo(root, targetCFrame, speed)
    local distance = (targetCFrame.Position - root.Position).Magnitude
    speed = math.max(speed or getgenv().FarmFlySpeed, 1)
    local duration = math.max(distance / speed, 0.05)
    local tween = TweenService:Create(
        root,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        {CFrame = targetCFrame}
    )
    tween:Play()
    local elapsed = 0
    while tween.PlaybackState == Enum.PlaybackState.Playing do
        if not getgenv().AutoFarmEnabled then tween:Cancel(); return false end
        elapsed = elapsed + task.wait(0.05)
        if elapsed > duration + 2 then tween:Cancel(); break end
    end
    root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then root.CFrame = targetCFrame end
    return true
end

local function moveToPositionForCrate(targetCFrame)
    local root = waitForRoot()
    if not root then return false end
    if getgenv().FarmMovementMode ~= "Fly" then
        root.CFrame = targetCFrame
        return true
    end
    local altitude = getgenv().FarmFlyAltitude or 150
    local ascendCFrame = root.CFrame + Vector3.new(0, altitude, 0)
    if not tweenRootTo(root, ascendCFrame, getgenv().FarmFlySpeed) then return false end
    if not getgenv().AutoFarmEnabled then return false end
    root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local aboveTarget = targetCFrame + Vector3.new(0, altitude, 0)
    if not tweenRootTo(root, aboveTarget, getgenv().FarmFlySpeed) then return false end
    if not getgenv().AutoFarmEnabled then return false end
    root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    if not tweenRootTo(root, targetCFrame, getgenv().FarmFlySpeed) then return false end
    return true
end

