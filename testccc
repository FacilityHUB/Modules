-- ==========================================
local Fling = (function()
    local spinFlingBAV      = nil
    local spinFlingDiedConn = nil
    local walkFlingLoop     = nil
    local walkFlingDiedConn = nil
    local antiFlingConn     = nil
    local flingNoclipActive = false

    local function getRoot()
        local char = LocalPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    local function getHumanoid()
        local char = LocalPlayer.Character
        return char and char:FindFirstChildOfClass("Humanoid")
    end

    local function pushFlingNoclip()
        if flingNoclipActive then return end
        flingNoclipActive = true
        autoFarmNoclipActive = true
        refreshNoclip()
    end

    local function popFlingNoclip()
        if not flingNoclipActive then return end
        flingNoclipActive = false
        if not getgenv().AutoFarmEnabled then
            autoFarmNoclipActive = false
            refreshNoclip()
        end
    end

    local function stopSpinFling()
        getgenv().SpinFlingEnabled = false
        if spinFlingDiedConn then spinFlingDiedConn:Disconnect(); spinFlingDiedConn = nil end
        local root = getRoot()
        if root then
            for _, v in ipairs(root:GetChildren()) do
                if v:IsA("BodyAngularVelocity") then pcall(function() v:Destroy() end) end
            end
        end
        spinFlingBAV = nil
        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    pcall(function()
                        p.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
                        p.Massless = false
                    end)
                end
            end
        end
        popFlingNoclip()
    end

    local function startSpinFling()
        stopSpinFling()
        getgenv().SpinFlingEnabled = true
        local char = LocalPlayer.Character
        local root = getRoot()
        local hum  = getHumanoid()
        if not (char and root and hum) then getgenv().SpinFlingEnabled = false; return end

        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                pcall(function() p.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5) end)
            end
        end

        pushFlingNoclip()
        task.wait(0.1)

        spinFlingBAV = Instance.new("BodyAngularVelocity")
        spinFlingBAV.Name            = "_FacilityFling"
        spinFlingBAV.AngularVelocity = Vector3.new(0, 99999, 0)
        spinFlingBAV.MaxTorque       = Vector3.new(0, math.huge, 0)
        spinFlingBAV.P               = math.huge
        spinFlingBAV.Parent          = root

        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
                v.Massless   = true
                v.Velocity   = Vector3.new(0, 0, 0)
            end
        end

        spinFlingDiedConn = hum.Died:Connect(stopSpinFling)

        task.spawn(function()
            while getgenv().SpinFlingEnabled do
                if spinFlingBAV and spinFlingBAV.Parent then
                    spinFlingBAV.AngularVelocity = Vector3.new(0, 99999, 0)
                end
                task.wait(0.2)
                if not getgenv().SpinFlingEnabled then break end
                if spinFlingBAV and spinFlingBAV.Parent then
                    spinFlingBAV.AngularVelocity = Vector3.new(0, 0, 0)
                end
                task.wait(0.1)
            end
        end)
    end

    local function stopWalkFling()
        getgenv().WalkFlingEnabled = false
        if walkFlingDiedConn then walkFlingDiedConn:Disconnect(); walkFlingDiedConn = nil end
        walkFlingLoop = nil
        popFlingNoclip()
    end

    local function startWalkFling()
        stopWalkFling()
        getgenv().WalkFlingEnabled = true
        local hum = getHumanoid()
        if hum then walkFlingDiedConn = hum.Died:Connect(stopWalkFling) end
        pushFlingNoclip()

        walkFlingLoop = task.spawn(function()
            while getgenv().WalkFlingEnabled do
                RunService.Heartbeat:Wait()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not (char and char.Parent and root and root.Parent) then continue end
                local vel   = root.Velocity
                local movel = 0.1
                root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                RunService.RenderStepped:Wait()
                char = LocalPlayer.Character
                root = char and char:FindFirstChild("HumanoidRootPart")
                if char and char.Parent and root and root.Parent then root.Velocity = vel end
                RunService.Stepped:Wait()
                char = LocalPlayer.Character
                root = char and char:FindFirstChild("HumanoidRootPart")
                if char and char.Parent and root and root.Parent then
                    root.Velocity = vel + Vector3.new(0, movel, 0)
                    movel = movel * -1
                end
            end
        end)
    end

    local function startAntiFling()
        if antiFlingConn then antiFlingConn:Disconnect() end
        getgenv().AntiFlingEnabled = true
        antiFlingConn = RunService.Stepped:Connect(function()
            if not getgenv().AntiFlingEnabled then return end
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    for _, v in ipairs(player.Character:GetDescendants()) do
                        if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
                    end
                end
            end
        end)
    end

    local function stopAntiFling()
        getgenv().AntiFlingEnabled = false
        if antiFlingConn then antiFlingConn:Disconnect(); antiFlingConn = nil end
    end

    LocalPlayer.CharacterAdded:Connect(function(char)
        char:WaitForChild("HumanoidRootPart")
        task.wait(0.3)
        if getgenv().SpinFlingEnabled then startSpinFling() end
        if getgenv().WalkFlingEnabled then startWalkFling() end
    end)

    return {
        startSpinFling = startSpinFling,
        stopSpinFling  = stopSpinFling,
        startWalkFling = startWalkFling,
        stopWalkFling  = stopWalkFling,
        startAntiFling = startAntiFling,
        stopAntiFling  = stopAntiFling,
    }
end)()

