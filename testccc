local function getCharacter()
    local c = LocalPlayer.Character
    return (c
        and c:FindFirstChild("HumanoidRootPart")
        and c:FindFirstChildOfClass("Humanoid")) and c or nil
end

local function waitForRoot(timeout)
    timeout = timeout or 10
    local elapsed = 0
    while elapsed < timeout do
        if LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            return LocalPlayer.Character.HumanoidRootPart
        end
        elapsed = elapsed + task.wait(0.1)
    end
    return nil
end

local function waitForLeaderstats(timeout)
    timeout = timeout or 30
    local elapsed = 0
    while not LocalPlayer:FindFirstChild("leaderstats") and elapsed < timeout do
        elapsed = elapsed + task.wait(0.1)
    end
    return LocalPlayer:FindFirstChild("leaderstats") ~= nil
end

local function getLeaderstatValue(name, fallback)
    local ok, val = pcall(function()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        if not ls then return nil end
        local stat = ls:FindFirstChild(name)
        return stat and stat.Value or nil
    end)
    if ok and val ~= nil then return val end
    return fallback
end

local function safeWait(duration)
    local elapsed = 0
    while elapsed < duration do
        if not getgenv().AutoFarmEnabled then return false end
        elapsed = elapsed + task.wait(0.1)
    end
    return true
end

local function holdKey(keyCode, duration)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    local ok = safeWait(duration)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    return ok
end

local function pressKey(keyCode)
    VirtualInputManager:SendKeyEvent(true,  keyCode, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

local function anchorAt(cframe, duration)
    local root = waitForRoot()
    if not root then return false end
    root.CFrame = cframe
    local prevAnchored = root.Anchored
    root.Anchored = true
    local ok = safeWait(duration)
    if root and root.Parent then
        root.Anchored = prevAnchored
    end
    return ok
end

-- ==========================================
--    NOCLIP ENGINE
-- ==========================================
local autoFarmNoclipActive = false

local function shouldNoclipBeActive()
    return autoFarmNoclipActive or getgenv().UserNoclipEnabled
end

local function snapshotCollideStates()
    originalCollideStates = {}
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            originalCollideStates[part] = part.CanCollide
        end
    end
end

local function applyNoclip()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            if originalCollideStates[part] == nil then
                originalCollideStates[part] = true
            end
            part.CanCollide = false
        end
    end
end

local function restoreCollideStates()
    for part, wasCollide in pairs(originalCollideStates) do
        if part and part.Parent then
            pcall(function() part.CanCollide = wasCollide end)
        end
    end
    originalCollideStates = {}
end

local function startNoclipConnection()
    if not noclipConnection then
        snapshotCollideStates()
        noclipConnection = RunService.Stepped:Connect(applyNoclip)
    end
end

local function stopNoclipConnection()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    restoreCollideStates()
end

local function refreshNoclip()
    if shouldNoclipBeActive() then
        startNoclipConnection()
    else
        stopNoclipConnection()
    end
end

local function enableNoclip()
    autoFarmNoclipActive = true
    refreshNoclip()
end

local function disableNoclip()
    autoFarmNoclipActive = false
    refreshNoclip()
end

