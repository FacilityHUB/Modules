local function runModeCrateDeposit()
    if not hasCrateTypesSelected() then StatusUI.setActive("No crate type selected"); safeWait(3); return end
    storeDiamondPlatePosition()
    if not DiamondPlatePos then StatusUI.setActive("DiamondPlate not found"); safeWait(3); return end

    while getgenv().AutoFarmEnabled do
        local depositedCount = #depositedCrates
        while depositedCount < getgenv().CrateCycleCount and getgenv().AutoFarmEnabled do
            if not pickupNewCrate() then
                doFallbackTeleport()
                if not getgenv().AutoFarmEnabled then return end
            else
                if not depositCrateAtSpot(depositedCount + 1) then
                    if not getgenv().AutoFarmEnabled then return end
                else
                    depositedCount = depositedCount + 1
                    if not safeWait(2) then return end
                end
            end
        end
        if not getgenv().AutoFarmEnabled then return end
        for i = 1, #depositedCrates do
            if not getgenv().AutoFarmEnabled then return end
            sellDepositedCrate(depositedCrates[i])
        end
        depositedCrates = {}
        getgenv().FarmStats.cyclesCompleted = getgenv().FarmStats.cyclesCompleted + 1
        if isCashTargetReached() then StatusUI.setActive("Cash target reached - switching to AutoBuy"); return end
    end
end

local function runModeCrateDirect()
    if not hasCrateTypesSelected() then StatusUI.setActive("No crate type selected"); safeWait(3); return end
    storeDiamondPlatePosition()
    if not DiamondPlatePos then StatusUI.setActive("DiamondPlate not found"); safeWait(3); return end

    while getgenv().AutoFarmEnabled do
        if not pickupNewCrate() then
            doFallbackTeleport()
            if not getgenv().AutoFarmEnabled then return end
        else
            StatusUI.setActive("Selling crate directly")
            if not moveToPositionForCrate(DiamondPlatePos) then
                if not getgenv().AutoFarmEnabled then return end
            else
                if not safeWait(1.5) then return end
                if not holdKey(Enum.KeyCode.E, 1.5) then return end
                if not safeWait(1) then return end
                getgenv().FarmStats.cratesSold      = getgenv().FarmStats.cratesSold + 1
                getgenv().FarmStats.cyclesCompleted = getgenv().FarmStats.cyclesCompleted + 1
            end
        end
        if isCashTargetReached() then StatusUI.setActive("Cash target reached - switching to AutoBuy"); return end
    end
end

local function runModeCrate()
    if getgenv().CrateSellMode == "Direct" then runModeCrateDirect() else runModeCrateDeposit() end
end

local function runModeCashCollector()
    while getgenv().AutoFarmEnabled do
        StatusUI.setActive("CashCollector - vacuuming")
        interactWithCashCollector()
        if not safeWait(0.5) then break end
        if isCashTargetReached() then StatusUI.setActive("Cash target reached - switching to AutoBuy"); break end
    end
end

local function visitCashCollector(duration)
    StatusUI.setActive("CashCollector - vacuuming (" .. duration .. "s)")
    local elapsed = 0
    while elapsed < duration and getgenv().AutoFarmEnabled do
        interactWithCashCollector()
        elapsed = elapsed + 0.5
        if not safeWait(0.5) then return false end
    end
    return true
end

local function runModeFusion()
    if not hasCrateTypesSelected() then StatusUI.setActive("No crate type selected"); safeWait(3); return end
    storeDiamondPlatePosition()
    if not DiamondPlatePos then StatusUI.setActive("DiamondPlate not found"); safeWait(3); return end

    while getgenv().AutoFarmEnabled do
        local depositedCount = #depositedCrates
        while depositedCount < getgenv().CrateCycleCount and getgenv().AutoFarmEnabled do
            if not pickupNewCrate() then
                doFallbackTeleport()
                if not getgenv().AutoFarmEnabled then return end
            else
                if not depositCrateAtSpot(depositedCount + 1) then
                    if not getgenv().AutoFarmEnabled then return end
                else
                    depositedCount = depositedCount + 1
                    if not safeWait(2) then return end
                end
            end
        end
        if not getgenv().AutoFarmEnabled then return end
        if not visitCashCollector(3) then return end
        for i = 1, #depositedCrates do
            if not getgenv().AutoFarmEnabled then return end
            sellDepositedCrate(depositedCrates[i])
        end
        depositedCrates = {}
        if isCashTargetReached() then StatusUI.setActive("Cash target reached - switching to AutoBuy"); return end
    end
end

