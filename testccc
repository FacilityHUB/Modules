            recursiveCleanup(tycoonRoot.Tycoons)
        end
    end
end)

local function applyNoFallDamage()
    if getgenv().NoFallDamageApplied then return end
    local ok, err = pcall(function()
        local FDMG = ReplicatedStorage:WaitForChild("ACS_Engine", 5)
            :WaitForChild("Events", 5):WaitForChild("FDMG", 5)
        if not FDMG then return end
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        local oldNamecall = mt.__namecall
        mt.__namecall = function(self, ...)
            local method = getnamecallmethod()
            if tostring(self) == "FDMG" and method == "FireServer" then return nil end
            return oldNamecall(self, ...)
        end
        setreadonly(mt, true)
    end)
    if ok then
        getgenv().NoFallDamageApplied = true
    else
        warn("[FacilityHub] No Fall Damage failed: " .. tostring(err))
    end
end

