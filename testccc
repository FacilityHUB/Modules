local function pickupNewCrate()
    local crate = findValidCrate()
    if not crate then return false end
    local root = waitForRoot()
    if not root then return false end
    local cratePos
    if crate:IsA("BasePart") then
        cratePos = crate.CFrame
    elseif crate:IsA("Model") and crate.PrimaryPart then
        cratePos = crate.PrimaryPart.CFrame
    else
        local first = crate:FindFirstChildWhichIsA("BasePart")
        cratePos = first and first.CFrame
    end
    if not cratePos then return false end
    StatusUI.setActive("Picking up crate (" .. tostring(crate.Name) .. ")")
    root.CFrame = cratePos + Vector3.new(0, 1, 0)
    if not safeWait(0.5) then return false end
    if not holdKey(Enum.KeyCode.E, 2.0) then return false end
    if not holdKey(Enum.KeyCode.E, 2.0) then return false end
    getgenv().FarmStats.cratesCollected = getgenv().FarmStats.cratesCollected + 1
    return true
end

local function depositCrateAtSpot(orderIndex)
    local depositCFrame = getDepositSpot(orderIndex)
    if not depositCFrame then return false end
    StatusUI.setActive("Depositing crate " .. orderIndex .. "/" .. getgenv().CrateCycleCount)
    if not moveToPositionForCrate(depositCFrame) then return false end
    if not getgenv().AutoFarmEnabled then return false end
    if not safeWait(2.5) then return false end
    if not holdKey(Enum.KeyCode.X, 0.5) then return false end
    if not safeWait(0.3) then return false end
    table.insert(depositedCrates, { order = orderIndex, depositCFrame = depositCFrame })
    return true
end

local function sellDepositedCrate(entry)
    if not entry then return false end
    local root = waitForRoot()
    if not root then return false end
    StatusUI.setActive("Retrieving deposited crate " .. entry.order .. "/" .. getgenv().CrateCycleCount)
    root.CFrame = entry.depositCFrame
    if not safeWait(0.5) then return false end
    if not holdKey(Enum.KeyCode.E, 1.0) then return false end
    StatusUI.setActive("Selling crate " .. entry.order .. "/" .. getgenv().CrateCycleCount)
    if not DiamondPlatePos then return false end
    if not moveToPositionForCrate(DiamondPlatePos) then return false end
    if not safeWait(1.5) then return false end
    if not holdKey(Enum.KeyCode.E, 1.5) then return false end
    if not safeWait(1) then return false end
    getgenv().FarmStats.cratesSold = getgenv().FarmStats.cratesSold + 1
    return true
end

